{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./hooks/scripts/session-start.sh",
        "osx": "./hooks/scripts/session-start.sh",
        "timeout": 15
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "./hooks/scripts/user-prompt-submit.sh",
        "osx": "./hooks/scripts/user-prompt-submit.sh",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "./hooks/scripts/pre-tool-use.sh",
        "osx": "./hooks/scripts/pre-tool-use.sh",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "./hooks/scripts/post-tool-use.sh",
        "osx": "./hooks/scripts/post-tool-use.sh",
        "timeout": 30
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "./hooks/scripts/pre-compact.sh",
        "osx": "./hooks/scripts/pre-compact.sh",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/scripts/session-stop.sh",
        "osx": "./hooks/scripts/session-stop.sh",
        "timeout": 30
      }
    ]
  }
}
